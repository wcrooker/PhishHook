# Optional environment for the PhishletGenerator sidecar (litellm keys).
# Copy to .env next to docker-compose.phishletgen.yml and fill in what you use.

# AI provider configuration for phishlet refinement (optional)
AI_API_KEY=
# Supported: deepseek/deepseek-chat, claude-3-5-sonnet-20241022, gpt-4o, ...
AI_MODEL=deepseek/deepseek-chat

# Enable the FlareSolverr fallback for Cloudflare-protected targets
FLARESOLVERR_ENABLED=false

# Generator settings
DEBUG=false
